# Dependencies — restored with `npm ci`, never committed.
node_modules/

# Build output. Regenerated by `npm run build`; committing it means every
# change shows up twice in the diff. If you later publish with GitHub Pages,
# build it in the Actions workflow rather than checking this in.
dist/

# Review and probe artefacts: screenshots and logs from the Playwright passes.
# The scripts that produce them are worth keeping, the output is not.
.impeccable/review/
*.log

# Local environment and editor state.
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
